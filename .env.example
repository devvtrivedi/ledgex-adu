# Copy to .env and fill in. .env is gitignored; this file is not.
#
# DATABASE_URL is what infra.env.get_db() reads, and load_dotenv searches
# UPWARD from the current working directory -- so any script run from the
# repo root picks this file up whether or not you meant it to (P39, README
# finding #43). get_db() therefore REFUSES a non-local host unless
# LEDGEX_ALLOW_REMOTE_DB=1 is set explicitly.
#
# Keep this value LOCAL. If you need a hosted database, pass it explicitly on
# the command line for that one command rather than parking it here, where
# every hand-run script in the repo will find it by accident.
DATABASE_URL=postgresql://localhost/ledgex_schema_check

# Local MinIO, dev only -- NOT R2. Swap OBJECT_STORE_URL for the real R2
# endpoint later; nothing else about ingestion code should need to change.
#
# The bucket must be created WITH Object Lock enabled (COMPLIANCE mode, 100y
# default retention). Object Lock can only be enabled at bucket CREATION,
# never retrofitted -- the real R2 bucket must be created that way from its
# very first `mc mb`/dashboard step.
OBJECT_STORE_URL=http://localhost:9000
OBJECT_STORE_BUCKET=ledgex-snapshots-locked
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Optional. `make smoke-real` reads this instead of DATABASE_URL and never
# falls back to it -- see the Makefile's own smoke-real comment for why.
# SMOKE_DATABASE_URL=postgresql://localhost/ledgex_smoke

# Optional. Where scripts/smoke_real.py expects the internal viewer.
# LEDGEX_VIEWER_URL=http://127.0.0.1:8420
